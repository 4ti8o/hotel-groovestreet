{
  "name": "hotel-groovestreet",
  "version": "1.0.0",
  "description": "Official website for Hotel GrooveStreet - A luxury hotel website built with the Palatin template",
  "main": "index.html",
  "scripts": {
    "start": "serve ./",
    "dev": "live-server ./ --port=3000",
    "build": "npx tailwindcss -i ./src/input.css -o ./style.css --minify && echo 'Build completed'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tailwind": "npx tailwindcss -i ./src/input.css -o ./style.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4ti8o/hotel-groovestreet.git"
  },
  "keywords": [
    "hotel",
    "website",
    "luxury",
    "accommodation",
    "booking",
    "travel",
    "tourism"
  ],
  "author": "Hotel GrooveStreet Development Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/4ti8o/hotel-groovestreet/issues"
  },
  "homepage": "https://github.com/4ti8o/hotel-groovestreet#readme",
  "devDependencies": {
    "live-server": "^1.2.2",
    "serve": "^14.2.1",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19"
  }
}
