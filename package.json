{
  "name": "hotel-groovestreet",
  "version": "1.0.0",
  "description": "Official website for Hotel GrooveStreet, Kampala - a luxury hotel website built with Tailwind CSS",
  "main": "index.html",
  "scripts": {
    "start": "serve ./",
    "dev": "live-server ./ --port=3001",
    "build:css": "tailwindcss -i ./src/input.css -o ./style.css --minify",
    "build:css:watch": "tailwindcss -i ./src/input.css -o ./style.css --watch",
    "build:pages": "node .kilo/build-pages.js",
    "build": "npm run build:css && npm run build:pages && echo 'Build completed'",
    "verify": "node .kilo/verify.js",
    "test": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4ti8o/hotel-groovestreet.git"
  },
  "keywords": [
    "hotel",
    "website",
    "luxury",
    "accommodation",
    "booking",
    "travel",
    "tourism"
  ],
  "author": "Hotel GrooveStreet Development Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/4ti8o/hotel-groovestreet/issues"
  },
  "homepage": "https://github.com/4ti8o/hotel-groovestreet#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "live-server": "^1.2.0",
    "postcss": "^8.4.38",
    "serve": "^14.2.1",
    "tailwindcss": "^3.4.1"
  }
}
